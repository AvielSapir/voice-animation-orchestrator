# Copy this file to .env and fill in real credentials locally (never commit .env)
GROQ_API_KEY=your-groq-api-key
STT_API_KEY=your-groq-api-key

CARTESIA_API_KEY=your-cartesia-api-key
TTS_API_KEY=your-cartesia-api-key
TTS_VOICE_ID=your-cartesia-voice-id

STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=cartesia
TTS_MODEL=sonic-3.6
LLM_PROVIDER=groq
# Selectable: qwen/qwen3.8-27b | openai/gpt-oss-120b | openai/gpt-oss-20b
LLM_MODEL=qwen/qwen3.8-27b
